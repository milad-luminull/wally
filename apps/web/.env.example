# Firebase Web SDK config for this app (from the Firebase console → Project settings →
# General → Your apps → SDK setup and configuration). Safe to expose client-side — these
# are public identifiers, not secrets; access is enforced by Firebase Auth + the API's
# token verification, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the Wally API (apps/api). No trailing slash.
# Local dev via docker-compose: http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Sign-in provider: firebase (local default) or auth0 (production).
VITE_AUTH_PROVIDER=firebase
# Public SPA client ID, required for an Auth0 release. Never use a client secret here.
# VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
# Auth0 issuer and REST audience are fixed in auth0Session.ts, including for local dev:
# https://login.luminull.com/ and https://api.wally.luminull.com
