# Base URL of the Wally API (apps/api). No trailing slash.
# Local dev via docker-compose: http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Public Auth0 SPA client ID. Optional: auth0Session.ts falls back to Wally's own SPA client.
# Never put a client secret in a VITE_* variable.
# VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
# Auth0 issuer and REST audience are fixed in auth0Session.ts, including for local dev:
# https://login.luminull.com/ and https://api.wally.luminull.com
