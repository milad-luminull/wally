{
  "name": "@wally/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "maintenance": "tsx src/maintenance.ts",
    "assistant:smoke": "tsx src/assistant-smoke.ts",
    "assistant:capture-eval": "tsx src/capture-eval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "5.0.132",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@wally/shared": "workspace:*",
    "ai": "7.0.163",
    "auth0": "7.7.0",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^6.2.15",
    "postgres": "3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@wally/config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
