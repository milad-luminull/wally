{
  "extends": "@wally/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "types": ["node"]
  },
  // No `rootDir` here (unlike tsconfig.build.json) — this config's `include` spans both
  // src/ and test/, and `rootDir` requires every included file to live under it. `tsc
  // --noEmit` (typecheck) enforces that constraint even without emitting. The integration
  // suites under test/ are included so `typecheck` covers them too; the `build` script
  // uses tsconfig.build.json (src only, with its own rootDir: "src") instead.
  "include": ["src", "test"],
  "exclude": ["dist", "node_modules"]
}
