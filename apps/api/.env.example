# Port the Fastify server listens on.
PORT=4000

# Firebase project the app belongs to. Its Cloud Firestore database is the datastore, and
# its Authentication is what issues the ID tokens this API verifies.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Admin SDK service-account credentials (Project settings > Service accounts >
# Generate new private key). Required to verify real ID tokens; optional when only talking
# to the Firestore emulator (e.g. running the test suites).
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# The private key's newlines must be escaped as \n when stored in a single-line .env
# value, e.g. "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n".
# The app un-escapes them (\n -> real newline) before handing the key to firebase-admin.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Point the Admin SDK's Firestore calls at a local emulator instead of the real database.
# docker-compose sets this for you; set it by hand when running the API on the host.
# Leave it unset to talk to the project's real Firestore.
FIRESTORE_EMULATOR_HOST=localhost:8080

# Origin of the web app, used for the CORS allow-list (e.g. http://localhost:5173).
CORS_ORIGIN=http://localhost:5173

# Which Firestore database to use. Leave UNSET locally — the emulator serves "(default)".
# Production (Cloud Run) sets it to `wally`, the europe-west3 database. Unset in production
# means the US "(default)" database, which is the wrong one and the single worst
# misconfiguration in this project. See docs/DEPLOY.md section 4.
# FIRESTORE_DATABASE_ID=wally

# Assistant deployment switch. Must be `true` or `false`; anything else fails at boot. Off by default.
ASSISTANT_ENABLED=false
# The deployment's model as provider:model. Providers: vertex, vertex-anthropic.
ASSISTANT_MODEL=vertex:gemini-3.8-flash
# Vertex region and project for the deployment route; the project defaults to FIREBASE_PROJECT_ID.
ASSISTANT_VERTEX_LOCATION=eu
# ASSISTANT_VERTEX_PROJECT=your-gcp-project-id
# Assistant caps: per-user daily tokens on any key; monthly micro-USD on the deployment key.
ASSISTANT_DAILY_CAP_TOKENS=300000
ASSISTANT_MONTHLY_CAP_MICRO_USD=15000000

# Auth0 REST authentication: opt-in only after account import and claim configuration.
AUTH0_ENABLED=false
# Enable new Auth0 accounts only after existing identities are imported and verified.
AUTH0_SIGNUP_ENABLED=false
AUTH0_ISSUER=https://login.luminull.com/
AUTH0_AUDIENCE=https://api.wally.luminull.com
# MCP is an independent opt-in and write access has its own kill switch.
MCP_ENABLED=false
MCP_WRITES_ENABLED=false
# Required for MCP activation; omit entirely when unused (never set a blank value).
# MCP_CLIENT_ID=your-approved-mcp-client-id
