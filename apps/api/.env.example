# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://wally:wally@localhost:5432/wally?schema=public"

# Port the Fastify server listens on.
PORT=4000

# Firebase Admin SDK service-account credentials (from your Firebase project's
# service account, Project settings > Service accounts > Generate new private key).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# The private key's newlines must be escaped as \n when stored in a single-line .env
# value, e.g. "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n".
# The app un-escapes them (\n -> real newline) before handing the key to firebase-admin.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Origin of the web app, used for the CORS allow-list (e.g. http://localhost:5173).
CORS_ORIGIN=http://localhost:5173
