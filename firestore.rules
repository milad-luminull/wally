rules_version = '2';

// Wally's data is read and written exclusively by the Fastify API through the Firebase
// Admin SDK, which bypasses these rules entirely. The web app holds no Firestore client
// and must never reach the database directly: every request goes through the API so that
// the whiteboard role checks in apps/api/src/lib/authorization.ts actually apply. Denying
// everything here is therefore the correct posture, not a placeholder — if a direct
// client read ever starts failing, the fix is to add an API endpoint, not to open a rule.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
