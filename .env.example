# Copy this file to .env and fill in real values. Never commit .env.
# docker-compose.yml reads this file automatically; apps/web also ships its own
# .env.example for running outside Docker.

# ---- apps/api ----
PORT=4000
# docker-compose publishes the web app on 5174 (5173 is taken on this machine).
CORS_ORIGIN=http://localhost:5174

# The API's PostgreSQL. docker-compose sets it to its own `postgres` service, so leave it
# unset here when you use compose; set it only to run the API outside Docker. Production
# reads it from Secret Manager (docs/DEPLOY.md), never from a file.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Assistant deployment switch. Must be `true` or `false`; anything else fails at boot. Off by default.
ASSISTANT_ENABLED=false
# The deployment's model as provider:model. The only provider is vertex (Gemini on Vertex).
ASSISTANT_MODEL=vertex:gemini-3.8-flash
# Vertex region and project for the deployment route. The project is required when
# ASSISTANT_ENABLED=true (the API refuses to start without it).
ASSISTANT_VERTEX_LOCATION=eu
# ASSISTANT_VERTEX_PROJECT=your-gcp-project-id
# Assistant caps: per-user daily tokens on any key; monthly micro-USD on the deployment key.
ASSISTANT_DAILY_CAP_TOKENS=300000
ASSISTANT_MONTHLY_CAP_MICRO_USD=15000000

# Sign-in is Auth0 everywhere, including local development (docs/AUTH0.md). Claims come
# from infra/auth0-post-login.cjs; the issuer (https://login.luminull.com/) and audience
# (https://api.wally.luminull.com) are fixed in the API, not configured here.
# Lets an unmapped Auth0 identity create its own Wally account: on locally, so your first
# sign-in creates your local account (on in production too).
AUTH0_SIGNUP_ENABLED=true
MCP_ENABLED=false
MCP_WRITES_ENABLED=false
# Required for MCP activation; omit entirely when unused (never set a blank value).
# MCP_CLIENT_ID=your-approved-mcp-client-id
# Local transport alias: development on a local database only; JWT audience remains canonical.
# MCP_LOCAL_URL=http://localhost:4502/mcp


# ---- apps/web ----
VITE_API_BASE_URL=http://localhost:4000
# Public Auth0 SPA client ID; never a client secret. Optional: the web app falls back to
# Wally's own SPA client, whose allowed callbacks include http://localhost:5174/login.
# VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
