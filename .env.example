# Copy this file to .env and fill in real values. Never commit .env.
# docker-compose.yml reads this file automatically; apps/web also ships its own
# .env.example for running outside Docker.

# ---- apps/api ----
PORT=4000
# docker-compose publishes the web app on 5174 (5173 is taken on this machine).
CORS_ORIGIN=http://localhost:5174

# The Firebase project. Data lives in its Cloud Firestore; locally, docker-compose points
# the API at the Firestore emulator instead (FIRESTORE_EMULATOR_HOST), so nothing you do in
# development touches the real database. Firebase ID tokens are verified with the project
# id alone (firebase-admin checks signatures against Google's public certificates). There
# is no service-account key: on Google Cloud the API uses Application Default Credentials,
# and anywhere else it refuses to start unless FIRESTORE_EMULATOR_HOST is set.
FIREBASE_PROJECT_ID=
# Which Firestore database to use. Leave UNSET locally — the emulator serves "(default)".
# Production (Cloud Run) sets it to `wally`, the europe-west3 database. Unset in production
# means the US "(default)" database, which is the wrong one and the single worst
# misconfiguration in this project. See docs/DEPLOY.md section 4.
# FIRESTORE_DATABASE_ID=wally
# Assistant deployment switch. Must be `true` or `false`; anything else fails at boot. Off by default.
ASSISTANT_ENABLED=false
# The deployment's model as provider:model. The only provider is vertex (Gemini on Vertex).
ASSISTANT_MODEL=vertex:gemini-3.8-flash
# Vertex region and project for the deployment route; the project defaults to FIREBASE_PROJECT_ID.
ASSISTANT_VERTEX_LOCATION=eu
# ASSISTANT_VERTEX_PROJECT=your-gcp-project-id
# Assistant caps: per-user daily tokens on any key; monthly micro-USD on the deployment key.
ASSISTANT_DAILY_CAP_TOKENS=300000
ASSISTANT_MONTHLY_CAP_MICRO_USD=15000000

# Auth0 token verification for the REST API (on in production; claims come from
# infra/auth0-post-login.cjs). The issuer (https://login.luminull.com/) and audience
# (https://api.wally.luminull.com) are fixed in the API, not configured here.
AUTH0_ENABLED=false
# Lets an unmapped Auth0 identity create its own Wally account (on in production).
AUTH0_SIGNUP_ENABLED=false
MCP_ENABLED=false
MCP_WRITES_ENABLED=false
# Required for MCP activation; omit entirely when unused (never set a blank value).
# MCP_CLIENT_ID=your-approved-mcp-client-id
# Local transport alias: development + emulator only; JWT audience remains canonical.
# MCP_LOCAL_URL=http://localhost:4502/mcp


# ---- apps/web ----
VITE_API_BASE_URL=http://localhost:4000
# Firebase Web SDK config — from the same Firebase project (Project Settings -> General
# -> Your apps -> Web app -> SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Web login provider. Auth0 activation also requires AUTH0_ENABLED=true on the API.
VITE_AUTH_PROVIDER=firebase
# Public SPA client ID; never a client secret.
# VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
