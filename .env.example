# Copy this file to .env and fill in real values. Never commit .env.
# docker-compose.yml reads this file automatically; apps/api and apps/web
# also ship their own .env.example for running outside Docker.

# ---- apps/api ----
PORT=4000
# docker-compose publishes the web app on 5174 (5173 is taken on this machine).
CORS_ORIGIN=http://localhost:5174

# Firebase Admin SDK (service account) — create a Firebase project, generate a service
# account key (Project Settings -> Service accounts -> Generate new private key), and
# fill these in from the downloaded JSON. Keep the \n escapes in the private key.
#
# Data lives in that project's Cloud Firestore. Locally, docker-compose points the API at
# the Firestore emulator instead (FIRESTORE_EMULATOR_HOST), so nothing you do in
# development touches the real database. ID tokens are still verified against the real
# project, but that needs only FIREBASE_PROJECT_ID — firebase-admin checks token signatures
# against Google's public certificates. So when FIRESTORE_EMULATOR_HOST is set you can leave
# the key pair out entirely; it is required only to reach a real Firestore.
FIREBASE_PROJECT_ID=
# NOTE: leave a value you do not have COMMENTED OUT, never blank. env.ts declares these
# z.string().min(1).optional(); .optional() accepts an absent key but REJECTS an empty
# string, and docker-compose's env_file turns `KEY=` into an empty string — so a blank line
# here makes the API throw at boot with "String must contain at least 1 character".
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Which Firestore database to use. Leave UNSET locally — the emulator serves "(default)".
# Production (Cloud Run) sets it to `wally`, the europe-west3 database. Unset in production
# means the US "(default)" database, which is the wrong one and the single worst
# misconfiguration in this project. See docs/DEPLOY.md section 4.
# FIRESTORE_DATABASE_ID=wally


# ---- apps/web ----
VITE_API_BASE_URL=http://localhost:4000
# Firebase Web SDK config — from the same Firebase project (Project Settings -> General
# -> Your apps -> Web app -> SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
