# Copy this file to .env and fill in real values. Never commit .env.
# docker-compose.yml reads this file automatically; apps/api and apps/web
# also ship their own .env.example for running outside Docker.

# ---- Postgres (used by docker-compose's db service and by DATABASE_URL below) ----
POSTGRES_USER=wally
POSTGRES_PASSWORD=wally
POSTGRES_DB=wally

# ---- apps/api ----
DATABASE_URL=postgresql://wally:wally@db:5432/wally
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK (service account) — create a Firebase project, generate a service
# account key (Project Settings -> Service accounts -> Generate new private key), and
# fill these in from the downloaded JSON. Keep the \n escapes in the private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- apps/web ----
VITE_API_BASE_URL=http://localhost:4000
# Firebase Web SDK config — from the same Firebase project (Project Settings -> General
# -> Your apps -> Web app -> SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
